{
  "name": "dbln-functions",
  "version": "0.1.0",
  "private": true,
  "description": "First-party social backend for dbln.me (likes now, comments next), served through the /api/** hosting rewrite.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "gen": "node scripts/gen-slugs.mjs",
    "prebuild": "npm run gen",
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node --test 'test/**/*.test.mjs'",
    "serve": "npm run build && node dev-server.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.1.0",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/nodemailer": "^8.0.1",
    "typescript": "^5"
  }
}
